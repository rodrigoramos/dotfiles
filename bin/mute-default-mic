#!/bin/bash

defaultSource=$(pactl info | grep -oP '(?<=Fonte padrão: ).+')
defaultCardNumber=$(LC_NUMERIC=en_US.UTF-8 pactl --format=json list sources | jq -c '.[] | select( .name == "'$defaultSource'") | .properties["alsa.card"] | tonumber')

# tenta alterar o microfone
amixer -c $defaultCardNumber sset Mic toggle &> /dev/null

# Se não funcionar
if [ $? == 0 ] ; then
  micType=Mic
else
  # vai pro capture
  amixer -c $defaultCardNumber sset Capture toggle

  if [ $? != 0 ]; then
    echo não foi possível determinar como alternar o microfone default
    echo Source: $defaultSource
    echo Alsa Card Number: $defaultCardNumber
    exit 1
  fi

  micType=Capture
fi

if [ "$(amixer controls | grep -o 'Dmic0')" != "" ] ; then
  defaultMicState=$(amixer -c $defaultCardNumber sget $micType | grep -o '\[off\]')
  if [[ $defaultMicState == *"[off]"* ]]; then
    amixer sset Dmic0 nocap
  else
    amixer sset Dmic0 cap
  fi
fi


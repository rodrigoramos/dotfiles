# Pacotes do macOS — instalados pelo ./install (brew bundle --file=macos/Brewfile)
tap "felixkratz/formulae"

# Shell e terminal
brew "fish"
brew "starship"
brew "eza"
brew "bat"
cask "kitty"
cask "font-jetbrains-mono-nerd-font"

# Editor e ferramentas usadas pelo nvim (telescope etc.)
brew "neovim"
brew "ripgrep"
brew "fd"
brew "git"
brew "git-delta"

# Trabalho: GitHub, Postgres (libpq + pgcli via pipx), GCP, APIs e bancos
brew "gh"
brew "libpq"
brew "pipx"
cask "gcloud-cli"
cask "insomnia"
cask "mongodb-compass"

# Notas
cask "logseq"

# Calendário (aliases/khal, equivalentes ao vdirsyncer do Linux)
brew "vdirsyncer"
brew "khal"

# Janelas, teclado e launcher (equivalentes a Hyprland, xkb e rofi)
brew "felixkratz/formulae/borders"
# Gerenciador de janelas tiling (config em macos/rift/config.toml)
brew "acsandmann/tap/rift"
# Barra no estilo do Rill, com os workspaces do Rift (config em macos/sketchybar)
brew "felixkratz/formulae/sketchybar"
brew "jq"
# Caps Lock -> Esc (config em macos/karabiner)
cask "karabiner-elements"
cask "raycast"
